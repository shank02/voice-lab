# VoiceLab environment settings
# Copy to .env and edit as needed.

# Dataset cache root
VOICELAB_DATA_DIR=./data

# MLflow local backend
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlruns

# MLflow experiment name
VOICELAB_EXPERIMENT_NAME=voicelab

# Streamlit → FastAPI connection
VOICELAB_API_URL=http://localhost:8000

# Hugging Face (for model weight downloads)
# HF_TOKEN=
HF_HOME=./data/hf

# Mozilla Data Collective (for Common Voice dataset download)
# Get your API key from https://data.mozilla.org
MDC_API_KEY=
